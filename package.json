{
    "name": "app",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22 <25"
    },
    "scripts": {
        "dev": "node scripts/dev-with-booking-api.js",
        "dev:doppler": "doppler run -- npm run dev",
        "build:doppler": "doppler run -- npm run build",
        "build": "node scripts/clean-public-output.js && next build && wrangler pages functions build functions --outdir .pages-functions --output-routes-path out/_routes.json --build-output-directory out && node scripts/install-pages-worker.js",
        "start": "next start",
        "test": "node --test tests/*.test.mjs",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "booking-server": "node booking-server.js"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.27.0",
        "next": "15.5.18",
        "node-html-parser": "^9.0.0",
        "posthog-js": "^1.408.1",
        "react": "^19.1.1",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.1.1",
        "react-phone-number-input": "^3.4.17",
        "shadcn": "^4.16.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@emnapi/core": "^1.11.2",
        "@emnapi/runtime": "^1.11.2",
        "@types/node": "^22.10.2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.32.0",
        "eslint-config-next": "15.4.4",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.0.7",
        "typescript": "^5.8.3",
        "wrangler": "^4.112.0"
    }
}
